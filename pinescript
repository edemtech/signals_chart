//@version=6
strategy("BOT#2 stable", overlay=true, pyramiding=1, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// === Индикаторы для ADAUSDT ===
src = close

// MACD
fast_length = input.int(12, title="MACD Fast Length")
slow_length = input.int(26, title="MACD Slow Length")
signal_length = input.int(9, title="MACD Signal Length")
macd = ta.ema(src, fast_length) - ta.ema(src, slow_length)
signal = ta.ema(macd, signal_length)

// Bollinger Bands (ADA)
bb_len = input.int(20, title="BB Length")
bb_mult = input.float(2.0, title="BB Mult")
basis = ta.sma(src, bb_len)
dev = bb_mult * ta.stdev(src, bb_len)
upper = basis + dev
lower = basis - dev

// RSI & MFI
rsi = ta.rsi(src, 14)
mfi = ta.mfi(src, 14)

// === BTCUSDT Bollinger Bands на 1h ===
btcClose = request.security("BINANCE:BTCUSDT", "60", close)
btcOpen = request.security("BINANCE:BTCUSDT", "60", open)
btcBBbasis = request.security("BINANCE:BTCUSDT", "60", ta.sma(close, bb_len))
btcDev = request.security("BINANCE:BTCUSDT", "60", bb_mult * ta.stdev(close, bb_len))
btcUpper = btcBBbasis + btcDev

// Фильтр BTC: запрет, если выше BB или пошел вниз
btcFilter = not (btcClose > btcUpper or (btcClose < btcOpen and btcClose > btcUpper * 0.98))

// === Условия входа/выхода ===
buyCond = ta.crossover(macd, signal) and (mfi < 40) and close < basis and btcFilter
// buyCond = ta.crossover(macd, signal) and close < basis and btcFilter
sellCond = rsi > 70 and close > upper

// === Сделки ===
if buyCond and strategy.position_size == 0
    strategy.entry("Buy", strategy.long)

if sellCond and strategy.position_size > 0
    strategy.close("Buy", comment="Sell")